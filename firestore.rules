rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Per-user data ──────────────────────────────────────────
    // Only the authenticated owner can read/write their own data
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Community Notice Board ─────────────────────────────────
    // Anyone can read posts (public board)
    // Any signed-in user can create a post
    // Any signed-in user can update (add replies) — reply array is append-only in JS
    match /artifacts/{appId}/public/noticeBoard/posts/{postId} {
      allow read:   if true;
      allow create: if request.auth != null
                    && request.resource.data.townName is string
                    && request.resource.data.message is string;
      allow update: if request.auth != null;
      // Prevent deletion by anyone except admin (set up Firebase Admin SDK for that)
      allow delete: if false;
    }
  }
}
